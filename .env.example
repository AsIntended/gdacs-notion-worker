# GDACS → Notion Worker configuration.
# Copy to `.env` for local runs, or push to the deployed worker with:
#   ntn workers env push
#
# Both variables are optional — the worker falls back to the defaults below.

# Which GDACS feed to pull. The 24-hour feed is the default and is plenty for a
# daily schedule. Other options include rss.xml (7-day) and rss_7d.xml.
GDACS_FEED=rss_24h.xml

# Minimum alert level to record. "Orange" keeps Orange + Red events;
# "Red" keeps Red only. Green events are always ignored.
MIN_ALERT=Orange
